table measure
	lineageTag: 7f8aaf75-4da8-4f49-913f-9a43e6e2141d

	measure 'Total Customers' = COUNT(fact_churn[customer_key])
		formatString: 0
		lineageTag: 461688f8-9e3c-45e2-b282-1ada7ca15d5c

	measure 'Churned Customers' =
			
			CALCULATE(
			    COUNTROWS('fact_churn'),
			    'fact_churn'[churn] = TRUE()
			)
		formatString: 0
		lineageTag: 4432ebb8-24b5-4e4d-8630-7cf83918ad02

	measure 'Churn Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fact_churn),
			        fact_churn[churn] = TRUE()
			    ),
			    COUNTROWS(fact_churn),
			    0
			)
		lineageTag: fac9129a-a240-45a4-b0d2-26f8fab64c38

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retained Customers' = [Total Customers] - [Churned Customers]
		formatString: 0
		lineageTag: 65eeb1e1-88ce-49eb-aac7-d959e4e00b8f

	measure churn_rate = COUNT(fact_churn[customer_key]) / 2666
		lineageTag: 35d2d22c-c8bd-47ba-8f6b-9a9462764f93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
		dataType: string
		lineageTag: 126e5bf2-c517-4398-9c4f-e96a93c7aef5
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition measure = m
		mode: import
		queryGroup: teleco_churn_model
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

