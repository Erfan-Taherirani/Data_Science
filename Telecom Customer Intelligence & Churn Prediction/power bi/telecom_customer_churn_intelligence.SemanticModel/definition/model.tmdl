model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup teleco_churn_model

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["complete_data","fact_churn","dim_state","dim_area_code","dim_plan","dim_churn","measure"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_churn
ref table dim_state
ref table dim_area_code
ref table dim_plan
ref table dim_churn
ref table measure

ref cultureInfo en-US

