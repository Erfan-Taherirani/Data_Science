model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup teleco_churn_model

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_churn","dim_state","dim_area_code","dim_intl_plan","dim_vmail_plan","measure","bst_model_high_feature_importance (2)","complete_data (2)","bst_model_high_feature_importance"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_churn
ref table dim_state
ref table dim_area_code
ref table dim_intl_plan
ref table measure
ref table dim_vmail_plan
ref table 'bst_model_high_feature_importance (2)'

ref cultureInfo en-US

